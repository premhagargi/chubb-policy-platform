# Copy to backend/.env and fill in what you need.
# Every value below has a working default except CEREBRAS_API_KEY.

# --- LLM provider -----------------------------------------------------------
# Without a key the app runs on the deterministic mock provider, and
# GET /api/v1/ai/health reports that it is doing so.
CEREBRAS_API_KEY=

# Any model your key can access. GET /api/v1/ai/health reports what is in use.
CEREBRAS_MODEL=gpt-oss-120b

# auto | cerebras | mock. "auto" picks Cerebras when a key is set, mock otherwise.
LLM_PROVIDER=auto

# Reasoning models spend part of this budget on hidden reasoning tokens before
# emitting any content, so a small value can yield an empty completion.
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# --- Persistence ------------------------------------------------------------
# SQLite by default so the POC runs with no external dependency.
# For Postgres: postgresql+asyncpg://chubb_app:chubb_dev_password@localhost:5432/chubb_policies
DATABASE_URL=sqlite+aiosqlite:///./chubb_policies.db
SEED_POLICY_COUNT=220

# --- In-memory cache --------------------------------------------------------
CACHE_LIST_TTL_SECONDS=30
CACHE_SUMMARY_TTL_SECONDS=60
CACHE_LLM_TTL_SECONDS=300
CACHE_MAX_ENTRIES=512

# --- API --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO
ENVIRONMENT=Development
