; @angular-devkit/build-angular@18 declares a peerOptional on tailwindcss ^2||^3,
; but this project runs Tailwind 4 through an explicit .postcssrc.json rather than
; the CLI's built-in Tailwind detection - so the constraint does not apply to how
; the build actually works. Recorded here (rather than as an ad-hoc install flag)
; so `npm install` succeeds for anyone cloning the repo.
legacy-peer-deps=true
